# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/hackathon_db"

# API
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_change_this_in_prod
JWT_EXPIRES_IN=7d

# Supabase
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Resend (email)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=hackathon@theaitel.com

# Luma Webhook
LUMA_WEBHOOK_SECRET=your_luma_webhook_secret

# Hackathon
HACKATHON_ID=default
