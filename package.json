{
  "name": "ai-voice-hackathon",
  "private": true,
  "version": "1.0.0",
  "description": "AI Voice Agent Hackathon Platform — Enterprise-grade hackathon management",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@hackathon/web",
    "dev:api": "turbo dev --filter=@hackathon/api",
    "build": "turbo build",
    "build:web": "turbo build --filter=@hackathon/web",
    "build:api": "turbo build --filter=@hackathon/api",
    "start": "pnpm --filter @hackathon/api exec prisma migrate deploy && pnpm --filter @hackathon/api exec prisma db seed && pnpm --filter @hackathon/api start",
    "start:web": "pnpm --filter @hackathon/web start",
    "start:api": "pnpm --filter @hackathon/api start",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean && rimraf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "rimraf": "^6.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
